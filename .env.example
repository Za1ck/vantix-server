# Public server HTTPS origin; Render supplies RENDER_EXTERNAL_URL if this is omitted.
BETTER_AUTH_URL=https://your-vantix-service.onrender.com
# Preserve the existing secret during a database switch. New install: random 32+ characters.
BETTER_AUTH_SECRET=

# neon deploy pulls these into .env.local (or .env if it already exists).
# Runtime: pooled PostgreSQL URL, with -pooler in the Neon hostname.
# Shape only: postgresql://ROLE:PASSWORD@ep-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE
DATABASE_URL=
# Explicit db:plan/db:migrate: direct URL to the SAME branch/database, without -pooler.
DATABASE_URL_UNPOOLED=
# Optional provider-supplied PEM CA. Certificate/hostname verification is always on.
POSTGRES_SSL_CA=

RESEND_API_KEY=
# Must be approved in Resend; the example below is not a usable sending address.
EMAIL_FROM="Vantix <accounts@your-verified-domain.example>"
REGISTRATION_ENABLED=true
PORT=3000
