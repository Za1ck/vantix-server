# Public server HTTPS origin; Render also supplies RENDER_EXTERNAL_URL automatically.
BETTER_AUTH_URL=https://your-vantix-service.onrender.com
# Generate a random 32+ character secret; enter directly in Render, never commit.
BETTER_AUTH_SECRET=
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=
# Optional PEM CA certificate only if supplied by your provider. Certificate verification is always on.
DB_SSL_CA=
RESEND_API_KEY=
# Must be an address on a verified Resend sending domain.
EMAIL_FROM=Vantix <accounts@your-verified-domain.example>
REGISTRATION_ENABLED=true
PORT=3000
