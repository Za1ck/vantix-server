{
  "name": "vantix-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.js && tsc --noEmit && npm test",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "test:neon": "node scripts/verify-neon-e2e.js",
    "db:plan": "node scripts/migrate.js",
    "db:migrate": "node scripts/migrate.js --apply"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "better-auth": "1.7.10",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
